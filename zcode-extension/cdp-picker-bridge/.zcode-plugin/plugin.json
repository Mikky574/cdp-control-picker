{
  "name": "cdp-picker-bridge",
  "version": "0.3.1",
  "description": "网页能力学习：让控件采集器通过 ZCode 自己的会话接口投递消息、打开对话并观察进度。",
  "extension": {
    "engines": { "zcode": "^1.4.0" },
    "main": "./extension.js",
    "activationEvents": ["onAvailable"],
    "grants": ["sessions.write", "sessions.fullAccess"],
    "protocols": { "sessions": 1, "rows": 4 },
    "contributes": {
      "commands": [{ "id": "authorize", "title": { "zh-CN": "连接网页控件采集器", "en-US": "Connect webpage picker" } }]
    }
  },
  "slots": {
    "composer.status": [{ "id": "bridge", "icon": "plug", "title": { "zh-CN": "网页控件采集", "en-US": "Webpage picker" }, "target": { "command": "authorize" } }]
  }
}
